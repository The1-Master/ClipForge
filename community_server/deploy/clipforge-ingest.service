[Unit]
Description=ClipForge private API contribution receiver
After=network.target

[Service]
Slice=clipforge-ingest.slice
Type=simple
User=clipforge-ingest
Group=clipforge-ingest
WorkingDirectory=/opt/clipforge-ingest
Environment=CLIPFORGE_DATA=/var/lib/clipforge-ingest
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
LoadCredential=token-pepper:/etc/clipforge-ingest/token-pepper
ExecStart=/opt/clipforge-ingest/venv/bin/gunicorn --config gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=clipforge-ingest
StateDirectoryMode=0700
MemoryMax=256M
MemoryHigh=224M
CPUQuota=25%
TasksMax=64
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET
ReadWritePaths=/var/lib/clipforge-ingest
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
LimitNOFILE=256

[Install]
WantedBy=multi-user.target

